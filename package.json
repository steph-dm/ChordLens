{
  "name": "chordlens",
  "version": "1.0.0",
  "description": "Explainable chord analysis, voicings, progressions for piano and MIDI notes",
  "author": "steph-dm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/steph-dm/ChordLens.git"
  },
  "type": "module",
  "exports": {
    ".": "./chord-analyzer.js",
    "./notes": "./notes.js",
    "./symbols": "./symbols.js",
    "./templates": "./templates.js"
  },
  "main": "chord-analyzer.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node tests/regression.js && node --test tests/*.test.js",
